rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function mine(userId) {
      return request.auth != null && request.auth.uid == userId;
    }

    match /users/{userId}/sync/{docId} {
      allow read: if mine(userId);
      allow create, update: if mine(userId)
        && docId == "meta"
        && request.resource.data.keys().hasOnly([
          "format", "revision", "count", "hash", "clientId",
          "appVersion", "schemaVersion", "updatedAt"
        ])
        && request.resource.data.format is int
        && request.resource.data.format == 3
        && request.resource.data.revision is int
        && request.resource.data.revision >= 1
        && request.resource.data.count is int
        && request.resource.data.count >= 0
        && request.resource.data.count <= 32
        && request.resource.data.hash is string
        && request.resource.data.hash.size() <= 64
        && request.resource.data.clientId is string
        && request.resource.data.clientId.size() <= 80
        && request.resource.data.appVersion is string
        && request.resource.data.appVersion.size() <= 32
        && request.resource.data.schemaVersion is int
        && request.resource.data.schemaVersion >= 1
        && request.resource.data.schemaVersion <= 100
        && request.resource.data.updatedAt is timestamp;
      allow delete: if mine(userId);
    }

    match /users/{userId}/chunks/{chunkId} {
      allow read: if mine(userId);
      allow create, update: if mine(userId)
        && request.resource.data.keys().hasOnly(["data", "revision", "index"])
        && request.resource.data.data is string
        && request.resource.data.data.size() <= 280000
        && request.resource.data.revision is int
        && request.resource.data.revision >= 1
        && request.resource.data.index is int
        && request.resource.data.index >= 0
        && request.resource.data.index < 32;
      allow delete: if mine(userId);
    }

    match /users/{userId}/{document=**} {
      allow read, write: if false;
    }
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
