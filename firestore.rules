rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function ownsUserSpace(uid) {
      return request.auth != null && request.auth.uid == uid
        && request.auth.token.email_verified == true;
    }

    function currentMeta(uid) {
      return get(/databases/$(database)/documents/users/$(uid)/sync/meta).data;
    }

    function nextMeta(uid) {
      return getAfter(/databases/$(database)/documents/users/$(uid)/sync/meta).data;
    }

    function validMeta(data) {
      return data.keys().hasAll(['format', 'revision', 'count', 'hash', 'clientId', 'appVersion', 'schemaVersion', 'updatedAt'])
        && data.keys().hasOnly(['format', 'revision', 'count', 'hash', 'clientId', 'appVersion', 'schemaVersion', 'updatedAt', 'deleted', 'cleanupPending', 'deletedAt'])
        && data.format is int && data.format == 4
        && data.revision is int && data.revision >= 1
        && data.count is int && data.count >= 0 && data.count <= 32
        && data.hash is string && data.hash.size() <= 64
        && data.clientId is string && data.clientId.size() <= 80
        && data.appVersion is string && data.appVersion.size() <= 32
        && data.schemaVersion is int && data.schemaVersion >= 1 && data.schemaVersion <= 100
        && data.updatedAt is timestamp && data.updatedAt == request.time
        && (
          (!data.keys().hasAny(['deleted', 'cleanupPending', 'deletedAt']))
          || (data.deleted == true && data.cleanupPending is bool && data.deletedAt is timestamp
            && data.count == 0 && data.hash == '')
        );
    }

    function advancesRevision() {
      return request.resource.data.revision > resource.data.revision
        // Reseeding waits until the previous tombstone's cleanup has finished.
        && (request.resource.data.get('deleted', false) == true
          || resource.data.get('deleted', false) == false
          || resource.data.get('cleanupPending', true) == false);
    }

    function completesDeletion() {
      return resource.data.format == 4
        && resource.data.get('deleted', false) == true
        && resource.data.get('cleanupPending', false) == true
        && request.resource.data.cleanupPending == false
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['cleanupPending', 'updatedAt']);
    }

    function validChunk(uid) {
      let data = request.resource.data;
      let meta = nextMeta(uid);
      return data.keys().hasAll(['data', 'revision', 'index', 'format'])
        && data.keys().hasOnly(['data', 'revision', 'index', 'format'])
        && data.format is int && data.format == 4
        && data.data is string && data.data.size() <= 280000
        && data.revision is int && data.revision >= 1
        && data.index is int && data.index >= 0 && data.index < 32
        && meta.format == 4 && meta.get('deleted', false) == false
        && meta.revision == data.revision && data.index < meta.count
        // Chunk writes and the new meta revision must be in the same transaction.
        // An individual write cannot silently replace the active snapshot.
        && (!exists(/databases/$(database)/documents/users/$(uid)/sync/meta)
          || currentMeta(uid).revision < data.revision);
    }

    // Meta writes must use the current conflict/deletion-aware cloud format.
    // This prevents an old cached client from recreating a copy the user deleted.
    match /users/{uid}/sync/meta {
      allow read: if ownsUserSpace(uid);
      allow create: if ownsUserSpace(uid) && validMeta(request.resource.data);
      allow update: if ownsUserSpace(uid) && validMeta(request.resource.data)
        && (advancesRevision() || completesDeletion());
    }

    match /users/{uid}/chunks/{chunkId} {
      allow read: if ownsUserSpace(uid);
      allow create, update: if ownsUserSpace(uid)
        && validChunk(uid);
      // Cached pre-v4 clients must not be able to erase the active revision
      // before their legacy meta write is rejected. Full chunk deletion is
      // allowed only behind a v4 tombstone; routine cleanup is limited to
      // sufficiently old revisions, including chunks left by a v3 client.
      allow delete: if ownsUserSpace(uid)
        && currentMeta(uid).format == 4
        && (
          currentMeta(uid).get('deleted', false) == true
          || (
            resource.data.revision is int
            && resource.data.revision < currentMeta(uid).revision - 2
          )
        );
    }

    match /users/{uid}/{document=**} {
      allow read, write: if false;
    }

    // Firestore rules are additive; this explicit fallback documents the default.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
