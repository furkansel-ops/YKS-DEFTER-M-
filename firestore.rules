rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function verifiedUser() {
      return request.auth != null
        && request.auth.token.email_verified == true;
    }

    function ownsUserSpace(userId) {
      return verifiedUser()
        && request.auth.uid == userId;
    }

    function profileRole(userId, roleName) {
      return verifiedUser()
        && exists(/databases/$(database)/documents/accountProfiles/$(userId))
        && get(/databases/$(database)/documents/accountProfiles/$(userId)).data.role == roleName;
    }

    function coachingLinkId(studentUid, coachUid) {
      return studentUid + '_' + coachUid;
    }

    function activeCoachingLink(studentUid, coachUid) {
      let linkId = coachingLinkId(studentUid, coachUid);
      return verifiedUser()
        && exists(/databases/$(database)/documents/coachingLinks/$(linkId))
        && get(/databases/$(database)/documents/coachingLinks/$(linkId)).data.studentUid == studentUid
        && get(/databases/$(database)/documents/coachingLinks/$(linkId)).data.coachUid == coachUid
        && get(/databases/$(database)/documents/coachingLinks/$(linkId)).data.active == true;
    }

    function claimedInviteCreatesLink(inviteCode, studentUid, coachUid) {
      let linkId = coachingLinkId(studentUid, coachUid);
      let link = getAfter(/databases/$(database)/documents/coachingLinks/$(linkId)).data;
      return link.studentUid == studentUid
        && link.coachUid == coachUid
        && link.inviteCode == inviteCode
        && link.active == true;
    }

    function claimedInviteMatchesLink(inviteCode, studentUid, coachUid) {
      let invite = getAfter(/databases/$(database)/documents/coachInvites/$(inviteCode)).data;
      return invite.status == 'claimed'
        && invite.studentUid == studentUid
        && invite.coachUid == coachUid;
    }

    function validStudentCoachCode(accessCode) {
      return accessCode is string
        && accessCode.matches('^[A-Z2-9]{12}$');
    }

    function reusableStudentCodeMatches(accessCode, studentUid) {
      return validStudentCoachCode(accessCode)
        && exists(/databases/$(database)/documents/studentCoachCodes/$(accessCode))
        && get(/databases/$(database)/documents/studentCoachCodes/$(accessCode)).data.code == accessCode
        && get(/databases/$(database)/documents/studentCoachCodes/$(accessCode)).data.studentUid == studentUid
        && get(/databases/$(database)/documents/studentCoachCodes/$(accessCode)).data.active == true;
    }

    function validAccountRole(roleName) {
      return roleName == 'student' || roleName == 'coach';
    }

    function validCoachRegistrationInvite(userId, inviteCode) {
      let before = get(/databases/$(database)/documents/coachRegistrationInvites/$(inviteCode)).data;
      let after = getAfter(/databases/$(database)/documents/coachRegistrationInvites/$(inviteCode)).data;
      return inviteCode is string
        && inviteCode.matches('^[A-Z2-9]{24}$')
        && before.status == 'open'
        && before.expiresAt is timestamp
        && before.expiresAt > request.time
        && after.status == 'used'
        && after.usedBy == userId
        && after.usedAt == request.time
        && after.updatedAt == request.time;
    }

    function validAccountProfile(data, userId) {
      return data.keys().hasAll(['uid', 'role', 'displayName', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly([
          'uid', 'role', 'displayName', 'coachTitle', 'specialization',
          'registrationInvite', 'createdAt', 'updatedAt'
        ])
        && data.uid == userId
        && validAccountRole(data.role)
        && data.displayName is string
        && data.displayName.size() >= 1 && data.displayName.size() <= 80
        && data.get('coachTitle', '') is string
        && data.get('coachTitle', '').size() <= 100
        && data.get('specialization', '') is string
        && data.get('specialization', '').size() <= 160
        && data.get('registrationInvite', '') is string
        && data.get('registrationInvite', '').size() <= 24
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function currentMeta(userId) {
      return get(/databases/$(database)/documents/users/$(userId)/sync/meta).data;
    }

    function nextMeta(userId) {
      return getAfter(/databases/$(database)/documents/users/$(userId)/sync/meta).data;
    }

    function validMetaShape(data) {
      return data.keys().hasAll([
          'format', 'revision', 'count', 'hash', 'clientId',
          'appVersion', 'schemaVersion', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'format', 'revision', 'count', 'hash', 'clientId',
          'appVersion', 'schemaVersion', 'updatedAt',
          'deleted', 'cleanupPending', 'deletedAt'
        ])
        && data.format is int && data.format == 4
        && data.revision is int && data.revision >= 1
        && data.count is int && data.count >= 0 && data.count <= 12
        && data.hash is string && data.hash.size() <= 64
        && data.clientId is string
        && data.clientId.size() >= 8 && data.clientId.size() <= 80
        && data.clientId.matches('^[A-Za-z0-9._:-]+$')
        && data.appVersion is string
        && data.appVersion.size() >= 1 && data.appVersion.size() <= 32
        && data.appVersion.matches('^[0-9A-Za-z][0-9A-Za-z._+-]*$')
        && data.schemaVersion is int
        && data.schemaVersion >= 1 && data.schemaVersion <= 100
        && data.updatedAt is timestamp
        && data.updatedAt == request.time;
    }

    function validActiveMeta(data) {
      return validMetaShape(data)
        && !data.keys().hasAny(['deleted', 'cleanupPending', 'deletedAt'])
        && data.count >= 1 && data.count <= 12
        && data.hash.matches('^[0-9a-f]{64}$');
    }

    function validDeletedMeta(data) {
      return validMetaShape(data)
        && data.keys().hasAll(['deleted', 'cleanupPending', 'deletedAt'])
        && data.deleted == true
        && data.cleanupPending is bool
        && data.deletedAt is timestamp
        && data.count == 0
        && data.hash == '';
    }

    function advancesActiveRevision() {
      return validActiveMeta(request.resource.data)
        && request.resource.data.revision == resource.data.revision + 1
        && (resource.data.get('deleted', false) == false
          || resource.data.get('cleanupPending', true) == false);
    }

    function startsDeletion() {
      return resource.data.format == 4
        && resource.data.get('deleted', false) == false
        && validDeletedMeta(request.resource.data)
        && request.resource.data.cleanupPending == true
        && request.resource.data.deletedAt == request.time
        && request.resource.data.revision == resource.data.revision + 1;
    }

    function completesDeletion() {
      return resource.data.format == 4
        && resource.data.get('deleted', false) == true
        && resource.data.get('cleanupPending', false) == true
        && validDeletedMeta(request.resource.data)
        && request.resource.data.cleanupPending == false
        && request.resource.data.revision == resource.data.revision
        && request.resource.data.deletedAt == resource.data.deletedAt
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['cleanupPending', 'updatedAt']);
    }

    function validChunk(userId, chunkId) {
      let data = request.resource.data;
      let meta = nextMeta(userId);
      return chunkId.matches('^[0-9]{10}_[0-9]{4}$')
        && data.keys().hasAll(['data', 'revision', 'index', 'format'])
        && data.keys().hasOnly(['data', 'revision', 'index', 'format'])
        && data.format is int && data.format == 4
        && data.data is string
        && data.data.size() > 0 && data.data.size() <= 720000
        && data.revision is int && data.revision >= 1
        && data.index is int && data.index >= 0 && data.index < 12
        && meta.format == 4
        && meta.get('deleted', false) == false
        && meta.count >= 1 && meta.count <= 12
        && meta.hash is string && meta.hash.matches('^[0-9a-f]{64}$')
        && meta.revision == data.revision
        && data.index < meta.count
        && meta.updatedAt is timestamp && meta.updatedAt == request.time;
    }

    function canDeleteChunk(userId, chunkId) {
      let meta = currentMeta(userId);
      return chunkId.matches('^[0-9]{10}_[0-9]{4}$')
        && meta.format == 4
        && (
          meta.get('deleted', false) == true
          || (
            resource.data.revision is int
            && resource.data.revision < meta.revision - 2
          )
        );
    }

    match /accountProfiles/{userId} {
      allow get: if verifiedUser();
      allow list: if false;
      allow create: if ownsUserSpace(userId)
        && validAccountProfile(request.resource.data, userId)
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time
        && (
          (request.resource.data.role == 'student'
            && !request.resource.data.keys().hasAny(['registrationInvite']))
          ||
          (request.resource.data.role == 'coach'
            && request.resource.data.keys().hasAll(['registrationInvite'])
            && validCoachRegistrationInvite(userId, request.resource.data.registrationInvite))
        );
      allow update: if ownsUserSpace(userId)
        && validAccountProfile(request.resource.data, userId)
        && request.resource.data.uid == resource.data.uid
        && request.resource.data.role == resource.data.role
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.get('registrationInvite', '') == resource.data.get('registrationInvite', '')
        && request.resource.data.updatedAt == request.time;
      allow delete: if false;
    }

    match /coachRegistrationInvites/{inviteCode} {
      allow get: if verifiedUser()
        && inviteCode.matches('^[A-Z2-9]{24}$');
      allow list, create, delete: if false;
      allow update: if verifiedUser()
        && inviteCode.matches('^[A-Z2-9]{24}$')
        && resource.data.status == 'open'
        && resource.data.expiresAt is timestamp
        && resource.data.expiresAt > request.time
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['status', 'usedBy', 'usedAt', 'updatedAt'])
        && request.resource.data.status == 'used'
        && request.resource.data.usedBy == request.auth.uid
        && request.resource.data.usedAt == request.time
        && request.resource.data.updatedAt == request.time
        && getAfter(/databases/$(database)/documents/accountProfiles/$(request.auth.uid)).data.uid == request.auth.uid
        && getAfter(/databases/$(database)/documents/accountProfiles/$(request.auth.uid)).data.role == 'coach'
        && getAfter(/databases/$(database)/documents/accountProfiles/$(request.auth.uid)).data.registrationInvite == inviteCode;
    }

    match /coachInvites/{inviteCode} {
      allow get: if verifiedUser()
        && (request.auth.uid == resource.data.studentUid
          || profileRole(request.auth.uid, 'coach'));
      allow list: if false;
      allow create: if verifiedUser()
        && profileRole(request.auth.uid, 'student')
        && inviteCode.matches('^[A-Z2-9]{10}$')
        && request.resource.data.keys().hasAll([
          'code', 'studentUid', 'coachUid', 'status',
          'createdAt', 'updatedAt', 'expiresAt'
        ])
        && request.resource.data.keys().hasOnly([
          'code', 'studentUid', 'coachUid', 'status',
          'createdAt', 'updatedAt', 'expiresAt'
        ])
        && request.resource.data.code == inviteCode
        && request.resource.data.studentUid == request.auth.uid
        && request.resource.data.coachUid == ''
        && request.resource.data.status == 'open'
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time
        && request.resource.data.expiresAt is timestamp
        && request.resource.data.expiresAt > request.time
        && request.resource.data.expiresAt <= request.time + duration.value(24, 'h');
      allow update: if verifiedUser()
        && profileRole(request.auth.uid, 'coach')
        && resource.data.status == 'open'
        && resource.data.expiresAt > request.time
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['coachUid', 'status', 'updatedAt'])
        && request.resource.data.coachUid == request.auth.uid
        && request.resource.data.status == 'claimed'
        && request.resource.data.updatedAt == request.time
        && claimedInviteCreatesLink(inviteCode, resource.data.studentUid, request.auth.uid);
      allow delete: if verifiedUser()
        && request.auth.uid == resource.data.studentUid;
    }

    match /studentCoachAccess/{studentUid} {
      allow get: if ownsUserSpace(studentUid);
      allow list: if false;
      allow create: if ownsUserSpace(studentUid)
        && profileRole(studentUid, 'student')
        && request.resource.data.keys().hasAll([
          'studentUid', 'code', 'active', 'createdAt', 'updatedAt'
        ])
        && request.resource.data.keys().hasOnly([
          'studentUid', 'code', 'active', 'createdAt', 'updatedAt'
        ])
        && request.resource.data.studentUid == studentUid
        && validStudentCoachCode(request.resource.data.code)
        && request.resource.data.active == true
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time;
      allow update: if ownsUserSpace(studentUid)
        && profileRole(studentUid, 'student')
        && request.resource.data.keys().hasAll([
          'studentUid', 'code', 'active', 'createdAt', 'updatedAt'
        ])
        && request.resource.data.keys().hasOnly([
          'studentUid', 'code', 'active', 'createdAt', 'updatedAt'
        ])
        && request.resource.data.studentUid == resource.data.studentUid
        && request.resource.data.studentUid == studentUid
        && request.resource.data.createdAt == resource.data.createdAt
        && validStudentCoachCode(request.resource.data.code)
        && request.resource.data.active == true
        && request.resource.data.updatedAt == request.time;
      allow delete: if ownsUserSpace(studentUid);
    }

    match /studentCoachCodes/{accessCode} {
      allow get: if verifiedUser()
        && (request.auth.uid == resource.data.studentUid
          || profileRole(request.auth.uid, 'coach'));
      allow list: if false;
      allow create: if verifiedUser()
        && profileRole(request.auth.uid, 'student')
        && validStudentCoachCode(accessCode)
        && request.resource.data.keys().hasAll([
          'code', 'studentUid', 'active', 'createdAt', 'updatedAt'
        ])
        && request.resource.data.keys().hasOnly([
          'code', 'studentUid', 'active', 'createdAt', 'updatedAt'
        ])
        && request.resource.data.code == accessCode
        && request.resource.data.studentUid == request.auth.uid
        && request.resource.data.active == true
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time
        && getAfter(/databases/$(database)/documents/studentCoachAccess/$(request.auth.uid)).data.code == accessCode
        && getAfter(/databases/$(database)/documents/studentCoachAccess/$(request.auth.uid)).data.active == true;
      allow update: if false;
      allow delete: if verifiedUser()
        && request.auth.uid == resource.data.studentUid;
    }

    match /coachingLinks/{linkId} {
      allow get, list: if verifiedUser()
        && (request.auth.uid == resource.data.studentUid
          || request.auth.uid == resource.data.coachUid);
      allow create: if verifiedUser()
        && profileRole(request.auth.uid, 'coach')
        && request.resource.data.keys().hasAll([
          'studentUid', 'coachUid', 'active', 'createdAt', 'updatedAt'
        ])
        && request.resource.data.coachUid == request.auth.uid
        && profileRole(request.resource.data.studentUid, 'student')
        && linkId == coachingLinkId(request.resource.data.studentUid, request.auth.uid)
        && request.resource.data.active == true
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time
        && (
          (
            request.resource.data.keys().hasAll(['inviteCode'])
            && request.resource.data.keys().hasOnly([
              'studentUid', 'coachUid', 'inviteCode', 'active',
              'createdAt', 'updatedAt', 'endedAt'
            ])
            && claimedInviteMatchesLink(
              request.resource.data.inviteCode,
              request.resource.data.studentUid,
              request.auth.uid
            )
          )
          ||
          (
            request.resource.data.keys().hasAll(['accessCode'])
            && request.resource.data.keys().hasOnly([
              'studentUid', 'coachUid', 'accessCode', 'active',
              'createdAt', 'updatedAt', 'endedAt'
            ])
            && reusableStudentCodeMatches(
              request.resource.data.accessCode,
              request.resource.data.studentUid
            )
          )
        );
      allow update: if verifiedUser()
        && (
          (
            (request.auth.uid == resource.data.studentUid
              || request.auth.uid == resource.data.coachUid)
            && resource.data.active == true
            && request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly(['active', 'endedAt', 'updatedAt'])
            && request.resource.data.active == false
            && request.resource.data.endedAt == request.time
            && request.resource.data.updatedAt == request.time
          )
          ||
          (
            profileRole(request.auth.uid, 'coach')
            && request.auth.uid == resource.data.coachUid
            && resource.data.active == false
            && request.resource.data.studentUid == resource.data.studentUid
            && request.resource.data.coachUid == resource.data.coachUid
            && request.resource.data.createdAt == resource.data.createdAt
            && request.resource.data.active == true
            && request.resource.data.updatedAt == request.time
            && request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly(['active', 'accessCode', 'updatedAt'])
            && validStudentCoachCode(request.resource.data.accessCode)
            && reusableStudentCodeMatches(
              request.resource.data.accessCode,
              resource.data.studentUid
            )
          )
        );
      allow delete: if false;
    }

    match /coachingShares/{studentUid} {
      allow get: if verifiedUser()
        && (request.auth.uid == studentUid
          || activeCoachingLink(studentUid, request.auth.uid));
      allow list: if false;
      allow create, update: if verifiedUser()
        && request.auth.uid == studentUid
        && profileRole(studentUid, 'student')
        && request.resource.data.keys().hasAll([
          'studentUid', 'version', 'profile', 'program', 'exams',
          'progress', 'paragraphProblem', 'topics', 'errorJournal', 'updatedAt'
        ])
        && request.resource.data.keys().hasOnly([
          'studentUid', 'version', 'profile', 'program', 'exams',
          'progress', 'paragraphProblem', 'topics', 'errorJournal', 'updatedAt'
        ])
        && request.resource.data.studentUid == studentUid
        && request.resource.data.version is int
        && request.resource.data.version == 1
        && request.resource.data.profile is map
        && request.resource.data.program is map
        && request.resource.data.exams is list
        && request.resource.data.progress is map
        && request.resource.data.paragraphProblem is map
        && request.resource.data.topics is map
        && request.resource.data.errorJournal is list
        && request.resource.data.updatedAt == request.time;
      allow delete: if verifiedUser()
        && request.auth.uid == studentUid;
    }

    function validCoachActionType(actionType) {
      return actionType == 'program_task'
        || actionType == 'topic_deadline'
        || actionType == 'coach_note'
        || actionType == 'post_exam_task';
    }

    match /coachingActions/{actionId} {
      allow get, list: if verifiedUser()
        && (request.auth.uid == resource.data.studentUid
          || request.auth.uid == resource.data.coachUid);
      allow create: if verifiedUser()
        && profileRole(request.auth.uid, 'coach')
        && request.resource.data.keys().hasAll([
          'studentUid', 'coachUid', 'type', 'payload', 'status',
          'createdAt', 'updatedAt'
        ])
        && request.resource.data.keys().hasOnly([
          'studentUid', 'coachUid', 'type', 'payload', 'status',
          'createdAt', 'updatedAt', 'handledAt', 'result'
        ])
        && request.resource.data.coachUid == request.auth.uid
        && validCoachActionType(request.resource.data.type)
        && request.resource.data.payload is map
        && request.resource.data.status == 'pending'
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time
        && activeCoachingLink(request.resource.data.studentUid, request.auth.uid);
      allow update: if verifiedUser()
        && resource.data.status == 'pending'
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['status', 'updatedAt', 'handledAt', 'result'])
        && request.resource.data.updatedAt == request.time
        && request.resource.data.handledAt == request.time
        && request.resource.data.get('result', '') is string
        && request.resource.data.get('result', '').size() <= 500
        && (
          (request.auth.uid == resource.data.studentUid
            && (request.resource.data.status == 'applied'
              || request.resource.data.status == 'rejected'))
          ||
          (request.auth.uid == resource.data.coachUid
            && request.resource.data.status == 'cancelled')
        );
      allow delete: if false;
    }

    match /users/{userId}/sync/meta {
      allow read: if ownsUserSpace(userId);
      allow create: if ownsUserSpace(userId)
        && validActiveMeta(request.resource.data);
      allow update: if ownsUserSpace(userId)
        && (
          advancesActiveRevision()
          || startsDeletion()
          || completesDeletion()
        );
      allow delete: if false;
    }

    match /users/{userId}/chunks/{chunkId} {
      allow read: if ownsUserSpace(userId);
      allow create: if ownsUserSpace(userId)
        && validChunk(userId, chunkId);
      allow update: if false;
      allow delete: if ownsUserSpace(userId)
        && canDeleteChunk(userId, chunkId);
    }

    match /users/{userId}/{document=**} {
      allow read, write: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
