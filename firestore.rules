rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedInAs(userId) {
      return request.auth != null && request.auth.uid == userId;
    }

    // YKS Defterim bulut senkron meta verisi.
    match /users/{userId}/sync/meta {
      allow read, write: if signedInAs(userId);
    }

    // YKS Defterim bulut senkron veri parçaları.
    match /users/{userId}/chunks/{chunkId} {
      allow read, write: if signedInAs(userId);
    }

    // Uygulamanın açıkça tanımlamadığı bütün Firestore yolları kapalıdır.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
